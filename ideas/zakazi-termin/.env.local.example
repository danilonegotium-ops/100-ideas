# Copy this file to `.env.local` (gitignored) and fill in real values.
# Never commit `.env.local`.

# --- Public — bundled into the browser JS. Safe to expose: Supabase access
# control comes from Row Level Security policies on each table, not from
# keeping these secret. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only — NEVER prefix with NEXT_PUBLIC_, never read from client
# code. Only reference these inside Server Components, Server Actions, or
# Route Handlers (app/api/**/route.ts). ---
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_AI_API_KEY=

# --- This idea's own additions (server-only) ---
# Optional. If unset, lib/email/sendEmail.ts logs and no-ops instead of
# sending — the booking flow works either way, this just gates whether
# confirmation/reminder emails actually go out. Get a free key at
# resend.com (no card required).
RESEND_API_KEY=
# Optional. If set, app/api/send-reminders/route.ts requires this as
# ?secret=... or an `Authorization: Bearer ...` header before running —
# set this before pointing a real cron job (Vercel Cron / GitHub Actions)
# at that endpoint, so it can't be triggered by anyone who finds the URL.
CRON_SECRET=
