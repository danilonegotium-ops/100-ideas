# Copy this file to `.env.local` (gitignored) and fill in real values.
# Never commit `.env.local`.

# --- Server-only — NEVER prefix with NEXT_PUBLIC_, never read from client
# code. Only referenced inside Route Handlers (app/api/**/route.ts). This
# tool is stateless (no accounts/DB), so the only secret it needs is the AI
# key. ---

# Google AI Studio key (https://aistudio.google.com/apikey), free tier.
GOOGLE_AI_API_KEY=

# Optional — defaults to gemini-2.0-flash in code if unset. Change this if
# that model name is retired/renamed by the time a real key exists; check
# https://ai.google.dev/gemini-api/docs/models for the current list.
GOOGLE_AI_MODEL=gemini-2.0-flash
