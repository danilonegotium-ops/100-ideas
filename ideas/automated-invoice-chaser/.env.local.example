# Copy this file to `.env.local` (gitignored) and fill in real values.
# Never commit `.env.local`.

# --- Public — bundled into the browser JS. Safe to expose: Supabase access
# control comes from Row Level Security policies on each table, not from
# keeping these secret. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only — NEVER prefix with NEXT_PUBLIC_, never read from client
# code. Only reference these inside Server Components, Server Actions, or
# Route Handlers (app/api/**/route.ts). ---
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_AI_API_KEY=

# Optional. If unset, "Send reminder" just logs what would have been sent
# (visible in the reminders trail in the UI) instead of emailing the
# client — the core flow works with zero configuration. resend.com, free
# tier, no card required.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
