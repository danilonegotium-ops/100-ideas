# Copy this file to `.env.local` (gitignored) and fill in real values.
# Never commit `.env.local`.
#
# This idea is stateless (no accounts/DB) — only a server-side AI key is
# needed. Never prefix with NEXT_PUBLIC_, never read from client code. Only
# referenced inside app/api/critique-logo/route.ts (a Route Handler, so it's
# never executed during `next build`, only at real request time).

GOOGLE_AI_API_KEY=
# Optional — vision-capable model name. Defaults to "gemini-2.0-flash" if
# unset (see lib/ai/gemini.ts). Not live-verified yet, no real key exists in
# this sprint — double check this is still a valid model name once one does.
GOOGLE_AI_MODEL=
