# Copy this file to `.env.local` (gitignored) and fill in real values.
# Never commit `.env.local`.

# --- Server-only — NEVER prefix with NEXT_PUBLIC_, never read from client
# code. Only referenced inside the Route Handler at app/api/generate/route.ts. ---

# Google AI Studio API key. Leave blank to run the app in "AI not configured"
# demo mode — the UI stays fully browsable, the form just returns a friendly
# message instead of a real recipe.
GOOGLE_AI_API_KEY=

# Optional — defaults to "gemini-2.0-flash" if unset (see lib/gemini.ts).
# NOTE: this default was chosen before a real GOOGLE_AI_API_KEY existed to
# verify against, so it may need updating to whatever Gemini model is
# actually current once the key is configured.
GOOGLE_AI_MODEL=
