# Copy this file to `.env.local` (gitignored) and fill in real values.
# Never commit `.env.local`.

# --- Public — bundled into the browser JS. Safe to expose: Supabase access
# control comes from Row Level Security policies on each table, not from
# keeping these secret. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only — NEVER prefix with NEXT_PUBLIC_, never read from client
# code. Only reference these inside Server Components, Server Actions, or
# Route Handlers (app/api/**/route.ts). ---
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_AI_API_KEY=

# --- Optional — email alerts via Resend (resend.com, free tier, no card).
# If RESEND_API_KEY is unset, alert emails are logged to the console instead
# of sent (see lib/resend.ts) — the app still works end-to-end without it.
RESEND_API_KEY=
# Resend's sandbox sender (works with no domain verification, but can only
# send TO the Resend account owner's own email until a real domain is
# verified — see SPEC.md). Override once a verified sending domain exists.
RESEND_FROM_EMAIL="Simple Uptime Monitor <onboarding@resend.dev>"

# --- Required before deploying — protects the cron endpoint
# (app/api/cron/check/route.ts) from being invoked by anyone on the public
# internet. Vercel automatically sends this value as
# `Authorization: Bearer $CRON_SECRET` when it triggers a Vercel Cron job
# (see vercel.json) — set the same value here and in the Vercel project's
# env vars. If unset, the route logs a warning and allows the request
# through anyway, so local dev works without it.
CRON_SECRET=
