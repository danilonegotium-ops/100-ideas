# Copy this file to `.env.local` (gitignored) and fill in real values.
# Never commit `.env.local`.
#
# This idea is stateless (no accounts/DB) — only a server-side AI key is
# needed. Transcription itself happens client-side for free via the
# browser's built-in Web Speech API (SpeechRecognition) — only the final
# summarization step calls the AI. Never prefix with NEXT_PUBLIC_, never
# read from client code. Only referenced inside
# app/api/summarize-minutes/route.ts (a Route Handler, never executed
# during `next build`, only at real request time).

GOOGLE_AI_API_KEY=
# Optional — text model name. Defaults to "gemini-2.0-flash" if unset (see
# lib/ai/gemini.ts). Not live-verified yet, no real key exists in this
# sprint — double check this is still a valid model name once one does.
GOOGLE_AI_MODEL=
