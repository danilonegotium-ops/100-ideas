# Copy this file to `.env.local` (gitignored) and fill in real values.
# Never commit `.env.local`.

# --- Public — bundled into the browser JS. Safe to expose: Supabase access
# control comes from Row Level Security policies on each table, not from
# keeping these secret. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only — NEVER prefix with NEXT_PUBLIC_, never read from client
# code. Only reference these inside Server Components, Server Actions, or
# Route Handlers (app/api/**/route.ts). ---
# Required by app/api/cron/deliver/route.ts (bypasses RLS to scan every
# user's letters, not just the signed-in caller's).
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_AI_API_KEY=

# --- Optional — this idea degrades gracefully without them. ---
# resend.com API key. Without it, the delivery cron logs
# "would send letter X to Y" instead of actually emailing (still marks the
# letter delivered, so idempotency behavior is identical either way).
RESEND_API_KEY=
# Must be a domain/sender verified in your Resend account. Falls back to
# Resend's shared onboarding sender if unset.
RESEND_FROM_EMAIL=
# If set, app/api/cron/deliver/route.ts requires this exact value in an
# `Authorization: Bearer <CRON_SECRET>` header (Vercel Cron sends this
# automatically when a CRON_SECRET env var exists on the project — verify
# this once the project is live). Left unset, the endpoint is open, which
# is fine for local/manual testing but should be set before relying on it
# in production.
CRON_SECRET=
