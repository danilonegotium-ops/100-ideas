# Copy this file to `.env.local` (gitignored) and fill in real values.
# Never commit `.env.local`.
#
# This idea is stateless (no accounts/DB) — only a server-side AI key is
# needed. Never prefix with NEXT_PUBLIC_, never read from client code. Only
# referenced inside app/api/decorate-room/route.ts (a Route Handler, never
# executed during `next build`, only at real request time).

GOOGLE_AI_API_KEY=

# Text/vision model used for the graceful TEXT fallback (furniture
# placement suggestions) and for the second-pass description that
# accompanies a generated image, if any. Defaults to "gemini-2.0-flash" if
# unset — same default as every other Wave 4/5 idea in this sprint.
GOOGLE_AI_MODEL=

# *** HIGHEST-RISK ENV VAR IN THE WHOLE SPRINT — SEE SPEC.md ***
# Model used for the actual image generation/editing attempt (room photo +
# style -> a new furnished-room image). Defaults to
# "gemini-2.0-flash-preview-image-generation" if unset, which is this
# template's best guess at a real, currently-existing Gemini image-output
# model id — NOT verified against a live API call (no key exists in this
# sprint). Free-tier availability of image generation/editing at all is
# genuinely uncertain. If the default model id is wrong/renamed/unavailable,
# the app still works via its TEXT-suggestions fallback (see SPEC.md) — it
# does not hard-fail. Once a real key exists: check Google AI Studio's
# current model list for the correct image-generation model id and set it
# here if different from the default.
GOOGLE_AI_IMAGE_MODEL=
